{
  "name": "@scienceevolve/sdk",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Config-driven ScienceEvolve research workflow runtime, without the Web/HTTP application.",
  "bin": {
    "scievolve": "./cli/scienceevolve.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./application/main-runtime": {
      "types": "./dist/main-runtime.d.ts",
      "import": "./dist/main-runtime.js"
    }
  },
  "files": [
    "cli",
    "dist",
    "assets",
    "docs",
    "skills",
    "README.md",
    "README_zh-CN.md",
    "examples",
    "resources/main-runtime"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "node scripts/sync-main-runtime.mjs --check && node scripts/build-typescript.mjs && node scripts/copy-assets.mjs && node scripts/check-branding.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:main-parity": "node scripts/sync-main-runtime.mjs --check-source",
    "check:main-runtime": "node scripts/sync-main-runtime.mjs --check",
    "check:branding": "node scripts/check-branding.mjs",
    "pretest": "node scripts/sync-main-runtime.mjs --check && node scripts/copy-assets.mjs && node scripts/check-branding.mjs",
    "test": "vitest run",
    "smoke:package": "node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.74.2",
    "@earendil-works/pi-coding-agent": "0.74.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "diff": "8.0.4",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
